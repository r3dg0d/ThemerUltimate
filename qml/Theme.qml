pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// ThemerUltimate theme singleton. GENERATED by tools/gen-theme-qml.py from tokens.json; do not edit by hand.
// Reads ~/.config/themer-ultimate/current.json (written by `themer-ultimate apply`) and watches it, so every
// widget restyles live. Fallbacks are the Purple Nebula values, so a missing file looks exactly like the rice.
// https://github.com/r3dg0d/ThemerUltimate
Singleton {
    id: theme
    property var d: ({})
    property int revision: 0                 // bumps on every theme change; Canvas items repaint on it
    readonly property string file: (Quickshell.env("XDG_CONFIG_HOME") || (Quickshell.env("HOME") + "/.config")) + "/themer-ultimate/current.json"

    FileView {
        id: fv
        path: theme.file
        watchChanges: true
        blockLoading: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: theme.load(text())
    }
    function load(s) {
        try { const j = JSON.parse(s); if (j && j.colors) { theme.d = j; theme.revision++ } } catch (e) {}
    }
    Component.onCompleted: load(fv.text())

    function c(k, def) { const v = d.colors ? d.colors[k] : undefined; return v ? v : def }
    function f(k, def) { const v = d.fonts ? d.fonts[k] : undefined; return v ? v : def }
    function g(k, def) { const v = d.glow ? d.glow[k] : undefined; return v !== undefined ? v : def }
    // helpers: alpha variant, "r,g,b" for Canvas rgba() strings, radius scaled by the theme
    function a(col, alpha) { return Qt.rgba(col.r, col.g, col.b, alpha) }
    function rgb(col) { return Math.round(col.r * 255) + "," + Math.round(col.g * 255) + "," + Math.round(col.b * 255) }
    function rgba(col, alpha) { return "rgba(" + rgb(col) + "," + alpha + ")" }
    function r(n) { return Math.round(n * radiusScale) }
    // per-theme icon glyphs (current.json "glyphs"), e.g. glyph("volume-high", Theme.glyph fallback); def when the theme has none
    function glyph(name, def) { const v = d.glyphs ? d.glyphs[name] : undefined; return v ? v : def }

    readonly property string themeId: d.id || "purple-nebula"
    readonly property string name: d.name || "Purple Nebula"
    readonly property bool isLight: (d.mode || "dark") === "light"
    // shape + glow
    readonly property real radiusScale: d.shape && d.shape.radiusScale !== undefined ? d.shape.radiusScale : 1.0
    readonly property real glowNebula: g("nebula", 1.0)   // painted nebula clouds behind widgets
    readonly property real glowStars: g("stars", 1.0)     // star field density
    readonly property real glowRim: g("rim", 1.0)         // lit window rim
    readonly property real glowRain: g("rain", 0.0)       // faint digital-rain glyph columns (H4X0R)
    // fonts
    readonly property string ui: f("ui", "Cellforge")
    readonly property string led: f("led", "Zerodot")
    readonly property string code: f("code", "NullType")
    readonly property string icons: f("icons", "JetBrainsMono Nerd Font")
    // colours
    readonly property color void_: c("void", "#07060d")   // deepest background, text on filled accents
    readonly property color base: c("base", "#0b0914")   // dark panels
    readonly property color surface: c("surface", "#0f0d1a")   // cards, bars
    readonly property color raised: c("raised", "#1a1630")   // hover / raised controls
    readonly property color window: c("window", "#0e0a1c")   // solid widget window fill
    readonly property color sel: c("sel", "#2a2147")   // selection background
    readonly property color line: c("line", "#26223a")   // borders, inactive rings
    readonly property color edge: c("edge", "#3a2f5c")   // stronger borders
    readonly property color edgeHot: c("edgeHot", "#5b3d99")   // focused / live borders
    readonly property color accent: c("accent", "#7c4dff")   // deep accent (pressed, focus ring start)
    readonly property color primary: c("primary", "#b46bff")   // primary accent
    readonly property color light: c("light", "#d4b8ff")   // light accent, labels on dark
    readonly property color hot: c("hot", "#ff6bd5")   // hot secondary accent
    readonly property color ink: c("ink", "#f2f0ff")   // primary text
    readonly property color bright: c("bright", "#ffffff")   // brightest text (clock)
    readonly property color text2: c("text2", "#c8c2e0")   // launcher list text
    readonly property color muted: c("muted", "#9a96b3")   // secondary text
    readonly property color label: c("label", "#8a84a8")   // small caps labels
    readonly property color dim: c("dim", "#5d5878")   // disabled text, comments
    readonly property color ok: c("ok", "#7dffa8")   // success
    readonly property color warn: c("warn", "#ffd479")   // warning
    readonly property color err: c("err", "#ff7a9a")   // error text
    readonly property color red: c("red", "#ff5c8a")   // urgent / critical
    readonly property color pink: c("pink", "#ff8fb1")   // power / destructive accent
    readonly property color cyan: c("cyan", "#6ee7f2")   // info, links
    readonly property color tile: c("tile", "#120f22")   // derived: mix surface raised 0.3
    readonly property color tile2: c("tile2", "#110d20")   // derived: mix surface raised 0.2
    readonly property color tile3: c("tile3", "#120e22")   // derived: mix surface raised 0.25
    readonly property color tile4: c("tile4", "#120c24")   // derived: mix surface accent 0.06
    readonly property color tile5: c("tile5", "#0f0b1c")   // derived: mix base surface 0.6
    readonly property color card: c("card", "#130e28")   // derived: mix surface raised 0.35
    readonly property color abyss: c("abyss", "#05040a")   // derived: mix void base -0.4
    readonly property color raised2: c("raised2", "#1c1536")   // derived: mix raised edge 0.1
    readonly property color raised3: c("raised3", "#1d1833")   // derived: mix raised line 0.3
    readonly property color raised4: c("raised4", "#221c3a")   // derived: mix raised line 0.7
    readonly property color raised5: c("raised5", "#22183f")   // derived: mix raised edge 0.3
    readonly property color raised6: c("raised6", "#2a2344")   // derived: mix raised edge 0.55
    readonly property color raised7: c("raised7", "#2e2650")   // derived: mix raised edge 0.75
    readonly property color edgeSoft: c("edgeSoft", "#33295a")   // derived: mix line edgeHot 0.4
    readonly property color rim: c("rim", "#6a52b0")   // derived: mix edgeHot primary 0.45
    readonly property color accent2: c("accent2", "#9d6bff")   // derived: mix accent primary 0.6
    readonly property color accent3: c("accent3", "#9b6bff")   // derived: mix accent primary 0.55
    readonly property color accent4: c("accent4", "#8a6bd8")   // derived: mix accent muted 0.4
    readonly property color orchid: c("orchid", "#c86bf0")   // derived: mix primary hot 0.35
    readonly property color soft1: c("soft1", "#a99fd0")   // derived: mix muted light 0.35
    readonly property color soft2: c("soft2", "#a49fc0")   // derived: mix muted light 0.2
    readonly property color soft3: c("soft3", "#9a8fc4")   // derived: mix muted accent 0.2
    readonly property color okBg: c("okBg", "#1d3a2a")   // derived: mix void ok 0.2
    readonly property color warnBg: c("warnBg", "#3a2d12")   // derived: mix void warn 0.2
    readonly property color errBg: c("errBg", "#3a1424")   // derived: mix void err 0.2
    readonly property color powerBg: c("powerBg", "#2a1230")   // derived: mix void pink 0.15
    readonly property color pink2: c("pink2", "#ff7aa2")   // derived: mix red pink 0.5
    readonly property color red2: c("red2", "#ff6b8f")   // derived: mix red err 0.5
    readonly property color warn2: c("warn2", "#ffc46b")   // derived: mix warn pink 0.15
    readonly property color sink: c("sink", "#4834be")   // nebula backdrop: deep cloud
    readonly property color rimGlow: c("rimGlow", "#b48cff")   // nebula backdrop: lit rim
}
